{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-urbanthreads-westus"
		},
		"ls_azsql_urban_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_azsql_urban'"
		},
		"ls_databricks_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'ls_databricks'"
		},
		"ls_dl_urbanstorage_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_dl_urbanstorage'"
		},
		"ls_azsql_urban_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlsrvr-urban-dev.database.windows.net"
		},
		"ls_azsql_urban_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-urban-dev"
		},
		"ls_azsql_urban_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"ls_dl_urbanstorage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dlurbanstorage.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-urbanthreads-westus_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_azsql_urban_password": {
						"value": "[parameters('ls_azsql_urban_password')]"
					},
					"ls_databricks_accessToken": {
						"value": "[parameters('ls_databricks_accessToken')]"
					},
					"ls_dl_urbanstorage_accountKey": {
						"value": "[parameters('ls_dl_urbanstorage_accountKey')]"
					},
					"ls_azsql_urban_properties_typeProperties_server": {
						"value": "[parameters('ls_azsql_urban_properties_typeProperties_server')]"
					},
					"ls_azsql_urban_properties_typeProperties_database": {
						"value": "[parameters('ls_azsql_urban_properties_typeProperties_database')]"
					},
					"ls_azsql_urban_properties_typeProperties_userName": {
						"value": "[parameters('ls_azsql_urban_properties_typeProperties_userName')]"
					},
					"ls_dl_urbanstorage_properties_typeProperties_url": {
						"value": "[parameters('ls_dl_urbanstorage_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}